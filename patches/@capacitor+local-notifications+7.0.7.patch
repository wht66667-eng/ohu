+package com.capacitorjs.plugins.localnotifications;
+
+import java.text.ParsePosition;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+import java.util.TimeZone;
+import org.json.JSONObject;
+
+/** Host course policy shared by scheduling, delivery and the offline replenisher. */
+public final class CourseReminderPolicy {
+    public static final long MAX_LATENESS_MS = 60 * 1000L;
+
+    private CourseReminderPolicy() {}
+
+    private static JSONObject parse(String source) {
+        try { return source == null ? null : new JSONObject(source); }
+        catch (Exception invalid) { return null; }
+    }
+    public static boolean isCourse(String source) { return isCourse(parse(source)); }
+    public static boolean isManagedReminder(String source) { return isManagedReminder(parse(source)); }
+    public static long originalAt(String source) { return originalAt(parse(source)); }
+    public static long expiresAt(String source) { return expiresAt(parse(source)); }
+    public static boolean usesAlarmClock(String source) { return usesAlarmClock(parse(source)); }
+
+    public static boolean isCourse(JSONObject source) {
+        JSONObject extra = source == null ? null : source.optJSONObject("extra");
+        String type = extra == null ? "" : extra.optString("type");
+        if (!type.isEmpty()) return "class".equals(type);
+        int id = source == null ? 0 : source.optInt("id");
+        // Old course records may have no extras. Their missing time/owner is not a licence to ring.
+        return id == 40999 || (id >= 41000 && id < 50000);
+    }
+
+    public static boolean isManagedReminder(JSONObject source) {
+        JSONObject extra = source == null ? null : source.optJSONObject("extra");
+        String type = extra == null ? "" : extra.optString("type");
+        return isCourse(source) || "todo".equals(type) || "exam".equals(type) || "cert".equals(type);
+    }
+
+    /** Keep the original event time even when an imminent alarm was moved by one second. */
+    public static long originalAt(JSONObject source) {
+        if (source == null) return -1;
+        JSONObject extra = source.optJSONObject("extra");
+        String value = extra == null ? "" : extra.optString("reminderAt", "");
+        if (value.isEmpty()) {
+            JSONObject schedule = source.optJSONObject("schedule");
+            value = schedule == null ? "" : schedule.optString("at", "");
+        }
+        return parseAt(value);
+    }
+
+    private static long parseAt(String value) {
+        // The host uses Date.toISOString(), matching the plugin's UTC date contract.
+        SimpleDateFormat format = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", Locale.US);
+        format.setTimeZone(TimeZone.getTimeZone("UTC"));
+        format.setLenient(false);
+        ParsePosition position = new ParsePosition(0);
+        Date parsed = format.parse(value, position);
+        return parsed == null || position.getIndex() != value.length() ? -1 : parsed.getTime();
+    }
+
+    /** Apply the one-minute cutoff to class, exam, todo and certification alarms. */
+    public static long expiresAt(JSONObject source) {
+        long at = originalAt(source);
+        if (at <= 0 || at > Long.MAX_VALUE - MAX_LATENESS_MS) return -1;
+        long expires = at + MAX_LATENESS_MS;
+        JSONObject extra = source == null ? null : source.optJSONObject("extra");
+        if (extra != null && ("todo".equals(extra.optString("type")) || "exam".equals(extra.optString("type")) || "cert".equals(extra.optString("type")))) return expires;
+        if (extra == null) return expires;
+        long start = extra.has("classStartAt") ? parseAt(extra.optString("classStartAt", "")) : -1;
+        long end = extra.has("classEndAt") ? parseAt(extra.optString("classEndAt", "")) : -1;
+        if ((extra.has("classStartAt") && start <= 0) || (extra.has("classEndAt") && (end <= 0 || (start > 0 && end <= start)))) return -1;
+        String kind = extra.optString("reminderKind", "");
+        if ("class-soon".equals(kind) && start > 0) expires = Math.min(expires, start);
+        if ("class-start".equals(kind) && end > 0) expires = Math.min(expires, end);
+        return expires;
+    }
+
+    public static boolean isExpired(JSONObject source, long now) {
+        if (!isManagedReminder(source)) return false;
+        long expires = expiresAt(source);
+        return expires <= 0 || now >= expires;
+    }
+
+    public static boolean usesAlarmClock(JSONObject source) {
+        JSONObject extra = source == null ? null : source.optJSONObject("extra");
+        return isCourse(source) && extra != null && extra.optBoolean("courseAlarmClock", true);
+    }
+
+    /** A broadcast already in flight must not consume a replacement with a reused ID. */
+    public static boolean sameCourseEvent(String expectedJson, JSONObject current) {
+        JSONObject expected = parse(expectedJson);
+        if (!isManagedReminder(expected) || !isManagedReminder(current)) return false;
+        JSONObject before = expected.optJSONObject("extra"), after = current.optJSONObject("extra");
+        if (before == null || after == null) return false;
+        if (!before.optString("type").equals(after.optString("type"))) return false;
+        JSONObject beforeSchedule = expected.optJSONObject("schedule"), afterSchedule = current.optJSONObject("schedule");
+        if (beforeSchedule == null || afterSchedule == null) return false;
+        return expected.optInt("id") == current.optInt("id")
+            && originalAt(expected) == originalAt(current)
+            && before.optString("ownerUid").equals(after.optString("ownerUid"))
+            && before.optString("todoId").equals(after.optString("todoId"))
+            && before.optString("reminderKind").equals(after.optString("reminderKind"))
+            && before.optString("classStartAt").equals(after.optString("classStartAt"))
+            && before.optString("classEndAt").equals(after.optString("classEndAt"))
+            && before.optString("expiresAt").equals(after.optString("expiresAt"))
+            && before.optBoolean("courseAlarmClock", true) == after.optBoolean("courseAlarmClock", true)
+            && beforeSchedule.optString("at").equals(afterSchedule.optString("at"))
+            && expected.optString("channelId").equals(current.optString("channelId"))
+            && expected.optString("title").equals(current.optString("title"))
+            && expected.optString("body").equals(current.optString("body"));
+    }
+}
