+package com.capacitorjs.plugins.localnotifications;
+
+import android.app.AlarmManager;
+import android.app.PendingIntent;
+import android.os.Build;
+
+/** Schedules only explicitly enabled, user-facing course alarms. */
+final class CourseReminderAlarm {
+    private CourseReminderAlarm() {}
+
+    static boolean schedule(String source, AlarmManager alarms, long at, PendingIntent show, PendingIntent operation) {
+        if (!CourseReminderPolicy.usesAlarmClock(source)) return false;
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S && !alarms.canScheduleExactAlarms()) return false;
+        try {
+            alarms.setAlarmClock(new AlarmManager.AlarmClockInfo(at, show), operation);
+        } catch (SecurityException permissionChanged) {
+            // Exact permission can change after the check. Preserve a best-effort course notice.
+            alarms.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, at, operation);
+        }
+        return true;
+    }
+}
