@@ -0,0 +1,24 @@
+package com.capacitorjs.plugins.localnotifications;
+
+import org.json.JSONObject;
+
+/** Personal student reminders must not leak from an older admin APK into its work shell. */
+public final class StudentReminderPolicy {
+    private StudentReminderPolicy() {}
+
+    public static boolean isStudent(JSONObject source) { return isStudent(source, source == null ? 0 : source.optInt("id")); }
+
+    public static boolean isStudent(JSONObject source, int id) {
+        JSONObject extra = source == null ? null : source.optJSONObject("extra");
+        String type = extra == null ? "" : extra.optString("type");
+        // Work notifications remain work notifications even if an older ID was reused.
+        if ("admin-work".equals(type)) return false;
+        if ("class".equals(type) || "exam".equals(type) || "todo".equals(type) || "cert".equals(type) || "self-test".equals(type)) return true;
+        return id == 40999 || (id >= 41000 && id < 50000) || (id >= 51000 && id < 53000) || (id >= 60000 && id < 60080) || id == 70011;
+    }
+
+    public static boolean isStudent(String source) {
+        try { return source != null && isStudent(new JSONObject(source)); }
+        catch (Exception invalid) { return false; }
+    }
+}
