# 哦狐后端服务环境变量
# 复制为 .env 后填写真实值

# 服务端口
PORT=3000
NODE_ENV=development

# PostgreSQL（CloudBase PG 或本地库）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ohu

# JWT 密钥（生产必须为高强度随机串）
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# 短信验证码（接入真实短信服务后填写；开发模式可用固定码 123456）
SMS_PROVIDER=mock
SMS_MOCK_CODE=123456

# CloudBase 环境（如需调用云函数/静态资源）
CLOUDBASE_ENV_ID=jou-d4gq7a3cqf51e6caa

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8080
