<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.sunshinecampus.app.TodayScheduleWidgetProvider"
            android:exported="false"
            android:label="今日课表">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_schedule_info" />
        </receiver>
        <receiver
            android:name="com.sunshinecampus.app.NextClassWidgetProvider"
            android:exported="false"
            android:label="下一节课">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_class_info" />
        </receiver>
    </application>
</manifest>
