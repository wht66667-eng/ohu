<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application>
        <receiver
            android:name="com.sunshinecampus.app.TodayScheduleWidgetProvider"
            android:exported="false"
            android:label="今日课表">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_schedule_info" />
        </receiver>
        <receiver
            android:name="com.sunshinecampus.app.NextClassWidgetProvider"
            android:exported="false"
            android:label="@string/widget_microgreen_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_class_info" />
        </receiver>
        <receiver android:name="com.sunshinecampus.app.ClassicGreetingWidgetProvider"
            android:exported="false" android:label="@string/widget_classic_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_classic_greeting_info" />
        </receiver>
        <receiver android:name="com.sunshinecampus.app.HanddrawnTodoWidgetProvider"
            android:exported="false" android:label="@string/widget_handdrawn_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_handdrawn_todo_info" />
        </receiver>
        <receiver android:name="com.sunshinecampus.app.SimpleShortcutWidgetProvider"
            android:exported="false" android:label="@string/widget_simple_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_simple_shortcuts_info" />
        </receiver>
        <receiver
            android:name="com.sunshinecampus.app.FoxCompanionWidgetProvider"
            android:exported="false"
            android:label="哦狐陪伴">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_fox_companion_info" />
        </receiver>
    </application>
</manifest>
