<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#FAF7EF">
    <TextView android:id="@+id/widget_day" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今日课表" android:textColor="#10513F" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_course_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:ellipsize="end" android:maxLines="1" android:textColor="#20352F" android:textSize="14sp" />
    <TextView android:id="@+id/widget_course_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:ellipsize="end" android:maxLines="1" android:textColor="#40564E" android:textSize="14sp" />
    <TextView android:id="@+id/widget_course_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:ellipsize="end" android:maxLines="1" android:textColor="#40564E" android:textSize="14sp" />
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="1" android:textColor="#6B7A72" android:textSize="12sp" />
</LinearLayout>
