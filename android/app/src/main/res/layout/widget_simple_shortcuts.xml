<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_simple_surface"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/widget_shortcut_1" style="@style/OhuWidgetShortcut" android:text="@string/widget_shortcut_schedule" />
        <TextView android:id="@+id/widget_shortcut_2" style="@style/OhuWidgetShortcut" android:text="@string/widget_shortcut_todo" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="#DADAD8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/widget_shortcut_3" style="@style/OhuWidgetShortcut" android:text="@string/widget_shortcut_grades" />
        <TextView android:id="@+id/widget_shortcut_4" style="@style/OhuWidgetShortcut" android:text="@string/widget_shortcut_services" />
    </LinearLayout>
</LinearLayout>
