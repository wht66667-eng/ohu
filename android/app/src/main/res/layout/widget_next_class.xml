<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#E7F2EC">
    <TextView android:id="@+id/widget_next_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="下一节课" android:textColor="#527168" android:textSize="13sp" />
    <TextView android:id="@+id/widget_next_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="1" android:text="打开哦狐同步课表" android:textColor="#10513F" android:textSize="19sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_next_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#20352F" android:textSize="15sp" />
    <TextView android:id="@+id/widget_next_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:textColor="#6B7A72" android:textSize="13sp" />
</LinearLayout>
