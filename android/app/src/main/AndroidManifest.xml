<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.chaoxing.mobile" />
    </queries>

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_mood_default"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_mood_default"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <!-- LAUNCHER 改由 activity-alias 承担，便于变脸切换 -->
        </activity>

        <!-- 默认图标 -->
        <activity-alias
            android:name=".LauncherDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_mood_default"
            android:roundIcon="@mipmap/ic_mood_default"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherStreak1" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_streak_1" android:roundIcon="@mipmap/ic_streak_1" android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherStreak3" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_streak_3" android:roundIcon="@mipmap/ic_streak_3" android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherStreak7" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_streak_7" android:roundIcon="@mipmap/ic_streak_7" android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherStreak14" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_streak_14" android:roundIcon="@mipmap/ic_streak_14" android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherAway2" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_away_2" android:roundIcon="@mipmap/ic_away_2" android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherAway5" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_away_5" android:roundIcon="@mipmap/ic_away_5" android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherAway8" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_away_8" android:roundIcon="@mipmap/ic_away_8" android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherAway12" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_away_12" android:roundIcon="@mipmap/ic_away_12" android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherAway15" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_away_15" android:roundIcon="@mipmap/ic_away_15" android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherAway20" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_away_20" android:roundIcon="@mipmap/ic_away_20" android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherAway25" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_away_25" android:roundIcon="@mipmap/ic_away_25" android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherAway30" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_away_30" android:roundIcon="@mipmap/ic_away_30" android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 多邻国式：开机 / 换日 / 覆盖安装后继续按未登录天数变脸 -->
        <receiver
            android:name=".IconMoodBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".FocusSessionEndReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 常驻提醒守护：可选开启，挂一条可见通知提高进程留在后台的机会。
             系统闹钟独立安排，实际送达仍受系统设置限制。用 specialUse 而非 dataSync：
             本服务不做数据同步，且 Android 15 起 dataSync 累计 6 小时会被强制结束。 -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="reminder_guardian" />
        </service>

        <!-- 开机 / 覆盖安装后把常驻提醒挂回去（用户关过则不动）。
             系统闹钟由本地通知插件的 LocalNotificationRestoreReceiver 另行恢复。 -->
        <receiver
            android:name=".KeepAliveBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Optional, account-owned desktop reminder mirror. No background service or full-screen activity. -->
        <receiver android:name=".ReminderPlanReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".ReminderOverlayReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Off by default. Requested only by the user's explicit desktop-reminder authorization action. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 常驻提醒守护服务（前台服务）；Android 14+ 需按类型声明 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 电池优化豁免：引导「关闭 App 也准时提醒」时需要 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 运动中心：计步 / 活动识别（Android 10+ 需运行时授权） -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 运动中心：心率等身体传感器 -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- 运动中心：健康类前台服务（Android 14+ 需按类型声明） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Google Fit 活动识别数据 -->
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />

    <!-- Android 11+ 必须声明 <queries> 才能用 queryIntentActivities 检测第三方 App 是否安装 -->
    <queries>
        <package android:name="com.newcapec.mobile.ncp" />
        <!-- Only these fixed packages are used by the express shortcut fallback. -->
        <package android:name="com.cainiao.wireless" />
        <package android:name="com.taobao.taobao" />
        <package android:name="com.xunmeng.pinduoduo" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.ss.android.ugc.aweme.lite" />
        <package android:name="com.jingdong.app.mall" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="cainiao" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="openapp.jdmobile" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="taobao" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tmall" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="weixin" />
        </intent>
    </queries>
</manifest>
