  "functions": [
    {
      "proname": "is_admin_user",
      "definition": "CREATE OR REPLACE FUNCTION public.is_admin_user()\n RETURNS boolean\n LANGUAGE sql\n STABLE\nAS $function$ SELECT EXISTS (\n     SELECT 1 FROM public.profiles p\n     WHERE p.uid = auth.uid() AND p.is_admin\n   ) $function$\n"
    },
    {
      "proname": "campus_post_like_count_delta",
      "definition": "CREATE OR REPLACE FUNCTION public.campus_post_like_count_delta()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nbegin\n  if tg_op = 'INSERT' then\n    update public.campus_posts set like_count = like_count + 1 where id = new.post_id;\n    return new;\n  end if;\n  update public.campus_posts set like_count = greatest(0, like_count - 1) where id = old.post_id;\n  return old;\nend;\n$function$\n"
    },
    {
      "proname": "campus_poi_submission_approval",
      "definition": "CREATE OR REPLACE FUNCTION public.campus_poi_submission_approval()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nbegin\n  if new.status='approved' and old.status='pending' then\n    if not public.is_admin_user() then raise exception 'admin approval required'; end if;\n    insert into public.campus_pois(campus_id,name,category,lng,lat,enabled,verification_status,verified_at,image_urls,note)\n    values (new.campus_id,new.name,new.category,new.lng,new.lat,true,'verified',now(),new.image_urls,new.note)\n    on conflict (campus_id,name) do nothing;\n    if not found then\n      raise exception '同名地点已存在，请核对已有地点并修改名称后重新审核';\n    end if;\n    new.reviewed_at=now();\n  elsif new.status='rejected' and old.status='pending' then\n    if not public.is_admin_user() then raise exception 'admin review required'; end if;\n    new.reviewed_at=now();\n  end if;\n  return new;\nend;\n$function$\n"
    },
    {
      "proname": "campus_valid_photo_urls",
