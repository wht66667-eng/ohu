{
  "name": "sunshine-campus",
  "private": true,
  "license": "MIT",
  "version": "1.2.157",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:h5": "node tools/build-multiplatform.mjs h5",
    "build:app": "node tools/build-multiplatform.mjs app",
    "test:fdroid": "node --test tools/fdroid-build.test.mjs",
    "build:web": "tsc -b && node tools/build-multiplatform.mjs h5",
    "build:all": "node tools/build-multiplatform.mjs all",
    "postinstall": "patch-package",
    "capgo:setup": "tools/capgo-setup.bat",
    "capgo:upload": "tools/capgo-upload.bat",
    "ota:upload": "node tools/ota-upload-cos.mjs",
    "ota:upload:skip-build": "node tools/ota-upload-cos.mjs --skip-build",
    "check:db-migrations": "node tools/deploy-db.mjs --check",
    "adventure:upload": "node tools/upload-pet-adventure.mjs",
    "games:upload": "node tools/upload-lyg-games.mjs",
    "world:upload": "node tools/upload-harbor-world.mjs",
    "release:5duan": "tools/release-5duan.bat",
    "release:android": "node tools/release-android.mjs --shell both",
    "release:user": "node tools/release-android.mjs --shell user",
    "release:admin": "node tools/release-android.mjs --shell admin",
    "release:plan": "node tools/release-android.mjs --shell both --plan",
    "ota:prepare": "node tools/ota-upload-cos.mjs --shell both --prepare-only --skip-recompress",
    "release:prepare": "node tools/prepare-release.mjs",
    "release:publish": "node tools/publish-release.mjs",
    "release:publish:plan": "node tools/publish-release.mjs --plan",
    "test:release": "node --test tools/app-update.test.mjs tools/live-update.test.mjs tools/release-tools.test.mjs tools/client-surface.test.mjs tools/admin-navigation.test.mjs tools/admin-workspace.test.mjs tools/app-shell.test.mjs tools/boot.test.mjs tools/shell-access.test.mjs tools/settings-section.test.mjs",
    "test:parsers": "node --test tools/campus-parsers.test.mjs",
    "gen:assets": "python tools/gen-native-assets.py",
    "gen:atlas": "python tools/make-stub-atlas.py --all",
    "import:atlas": "python tools/import-spriteforge.py",
    "import:petdex": "node tools/import-petdex-packs.mjs",
    "sync:android": "npx cap sync android",
    "sync:ios": "npx cap sync ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "lint": "oxlint",
    "deploy:hosting": "node tools/deploy-hosting.mjs",
    "deploy:db": "node tools/deploy-db.mjs",
    "smoke:hosting": "node tools/smoke-hosting.mjs",
    "security:check": "node tools/security-predeploy-check.mjs",
    "preview": "vite preview",
    "story:smoke": "node tools/run-story-smoke.mjs && node .tmp-smoke/smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/capacitor-updater": "^7.51.23",
    "@cloudbase/js-sdk": "^3.9.3",
    "browser-image-compression": "^2.0.2",
    "capacitor-freerasp": "^3.2.1",
    "fabric": "7.4.0",
    "fft.js": "4.0.4",
    "maplibre-gl": "6.15.0",
    "motion": "^13.4.4",
    "pmtiles": "4.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.4",
    "react-router-dom": "^7.18.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@capgo/cli": "^8.67.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.6.1",
    "jsqr": "^1.4.0",
    "oxlint": "^1.81.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
